{
  "name": "raydio",
  "version": "0.1.0",
  "private": true,
  "description": "A private YouTube-first Discord music bot.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "tsx watch src/index.ts",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "postinstall": "node scripts/patch-shoukaku-reconnect.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "pino": "10.3.1",
    "shoukaku": "4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
