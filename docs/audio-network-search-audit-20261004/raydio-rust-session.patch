+            "track":{"userData":{"raydioGeneration":generation}}}))).await.unwrap();
+        tokio::time::sleep(Duration::from_millis(350)).await;
+        let endpoint = format!("/v4/sessions/{}/players/1", shared.node.health().session);
+        let player = shared.node.request(reqwest::Method::GET, &endpoint, &[], None).await.unwrap();
+        let stalled = player["track"]["userData"]["raydioGeneration"] == generation;
+        release.notify_one();
