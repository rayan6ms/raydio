+    #[tokio::test]
+    async fn audit_dropped_stop_future_leaves_audio_slot_busy() {
+        let (gateway, udp) = peer(FakeVoiceGatewayConfig::local()).await;
+        let oto = Oto::builder().test_tls_config(gateway.tls().client_config()).build().unwrap();
+        let backend = OtoVoiceBackend::new(oto, 2, 1);
+        let connection = backend.connect(voice_info(&gateway, 3), CancellationToken::new()).await.unwrap();
+        connection.set_source(Arc::new(PendingSource), CancellationToken::new()).await.unwrap();
+        let mut stop = connection.stop_audio();
+        std::future::poll_fn(|cx| {
+            assert!(stop.as_mut().poll(cx).is_pending());
+            std::task::Poll::Ready(())
+        }).await;
+        drop(stop);
+        tokio::task::yield_now().await;
+        let err = connection.set_source(Arc::new(PendingSource), CancellationToken::new()).await.unwrap_err();
+        assert_eq!(err.kind, VoiceErrorKind::Overloaded);
+        assert!(tokio::time::timeout(Duration::from_millis(50), connection.shutdown()).await.is_err());
+        println!("dropped stop: replacement=Overloaded, shutdown still blocked after 50 ms");
+        // Repair only the test-owned slot so cleanup is bounded.
+        let concrete = backend.inner.connections.lock().unwrap()[0].upgrade().unwrap();
+        concrete.finish_audio(AudioSlot::Idle);
+        concrete.closed.store(false, Ordering::Release);
+        connection.shutdown().await.unwrap();
+        backend.shutdown().await.unwrap();
+        drop((gateway, udp));
+    }
+
