#!/usr/bin/env bash
# Versioned native deployments. No compiler, container, or background updater on the VM.
set -euo pipefail
root=/opt/raydio
service=raydio.service
fail() { echo "$*" >&2; exit 1; }
usage() { echo 'raydioctl install PACKAGE | start | update TAG_OR_PACKAGE | rollback | status | logs'; }
command=${1:-help}
case "$command" in
    status) exec systemctl status "$service" ;;
    logs) exec journalctl -u "$service" -n 100 -f ;;
    help|--help|-h) usage; exit 0 ;;
    install|start|update|rollback) ;;
    *) usage; exit 1 ;;
esac
[[ $(id -u) == 0 ]] || fail 'Run this command with sudo.'
exec 9>/run/lock/raydio-deploy.lock
flock -n 9 || fail 'Another Raydio deployment is running.'
link_current() {
    ln -s "$1" "$root/current.next"
    mv -Tf "$root/current.next" "$root/current"
}
reset_failure() {
    # reset-failed can reject a newly installed, not-yet-loaded inactive unit.
    # Only failed units need their restart-rate counter cleared.
    if systemctl is-failed --quiet "$service"; then
        systemctl reset-failed "$service"
    fi
}
load_service() {
    install -m644 "$1/deploy/raydio.service" /etc/systemd/system/raydio.service
    systemctl daemon-reload
    reset_failure
}
activate() {
    local next=$1 old=${2:-}
    link_current "$next"
    load_service "$next"
    if systemctl restart "$service"; then
        if [[ -n "$old" && "$old" != "$next" ]]; then
            ln -sfn "$old" "$root/previous"
        fi
        echo "Raydio ready: $(cat "$next/REVISION")"
    else
        if [[ -n "$old" ]]; then
            echo 'New version failed readiness; restoring previous release.' >&2
            link_current "$old"
            load_service "$old"
            systemctl restart "$service" || echo 'Previous release also failed; inspect journalctl -u raydio.' >&2
        fi
        fail 'Deployment failed. Environment file was preserved.'
    fi
}
if [[ "$command" == start ]]; then
    systemctl enable "$service"
    reset_failure
    systemctl start "$service" # Type=notify waits for Discord readiness.
    exit
fi
if [[ "$command" == rollback ]]; then
    [[ -L "$root/previous" && -L "$root/current" ]] || fail 'No previous release available.'
    activate "$(readlink -f "$root/previous")" "$(readlink -f "$root/current")"
    exit
fi
[[ $# == 2 ]] || fail 'Specify a release tag or package path.'
if [[ "$command" == install && -e "$root/current" ]]; then fail 'Already installed; use update.'; fi
if [[ "$command" == update && ! -e "$root/current" ]]; then fail 'Install Raydio first.'; fi
temp=$(mktemp -d)
trap 'rm -rf "$temp"' EXIT
package=$2
if [[ "$package" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]]; then
    arch=$(uname -m)
    case "$arch" in x86_64|aarch64) ;; *) fail 'Unsupported CPU architecture.';; esac
    asset="raydio-linux-$arch.tar.gz"
    base="https://github.com/rayan6ms/raydio/releases/download/$package"
    curl --fail --location --proto '=https' --tlsv1.2 --retry 3 --max-time 180 "$base/$asset" -o "$temp/$asset"
    curl --fail --location --proto '=https' --tlsv1.2 --retry 3 --max-time 60 "$base/$asset.sha256" -o "$temp/$asset.sha256"
    (cd "$temp" && sha256sum --check "$asset.sha256")
    package="$temp/$asset"
fi
[[ -f "$package" ]] || fail 'Package not found.'
mkdir "$temp/release"
tar --extract --gzip --file "$package" --directory "$temp/release" --no-same-owner --no-same-permissions
(cd "$temp/release" && sha256sum --check --quiet SHA256SUMS)
revision=$(cat "$temp/release/REVISION")
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || fail 'Invalid release revision.'
chmod 755 "$temp/release/bin/raydio"
"$temp/release/bin/raydio" --version
timeout 30 "$temp/release/bin/raydio" --check
if ! id raydio >/dev/null 2>&1; then
    useradd --system --user-group --home-dir /var/lib/raydio --shell /usr/sbin/nologin raydio
fi
[[ $(id -u raydio) != 0 ]] || fail 'The raydio service user must not be root.'
install -d -m755 "$root" "$root/releases"
install -d -m700 /etc/raydio
install -d -m750 -o raydio -g raydio /var/lib/raydio
if [[ ! -f /etc/raydio/env ]]; then
    install -m600 "$temp/release/deploy/env.example" /etc/raydio/env
fi
next="$root/releases/$revision"
if [[ -e "$next" ]]; then
    cmp "$temp/release/SHA256SUMS" "$next/SHA256SUMS" || fail 'Same revision has different contents; refusing to overwrite it.'
else
    mv "$temp/release" "$next"
    chmod -R go-w "$next"
fi
chmod 755 "$next"
install -m755 "$next/deploy/raydioctl" /usr/local/bin/raydioctl
if [[ "$command" == install ]]; then
    link_current "$next"
    load_service "$next"
    echo 'Installed. Set DISCORD_TOKEN in /etc/raydio/env, then run sudo raydioctl start.'
else
    activate "$next" "$(readlink -f "$root/current")"
fi
