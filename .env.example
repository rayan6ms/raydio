# Production token. Select the test token only with --testbot.
DISCORD_TOKEN=
DISCORD_TOKEN_TESTBOT=
LOG_LEVEL=info
DEFAULT_VOLUME=70
IDLE_DISCONNECT_SECONDS=120
ALONE_DISCONNECT_SECONDS=120
MAX_PENDING_PLAY_REQUESTS=10
MAX_QUEUE_TRACKS=1000
MAX_PLAYLIST_TRACKS=250
MAX_TRACK_DURATION_HOURS=3
ALLOW_LIVESTREAMS=false
# Optional YouTube source credentials. Keep these in the deployment secret file;
# never commit or log them. OAuth and proof-of-origin inputs are alternatives.
RAYDIO_YOUTUBE_OAUTH_ACCESS_TOKEN=
RAYDIO_YOUTUBE_OAUTH_REFRESH_TOKEN=
RAYDIO_YOUTUBE_COOKIES=
RAYDIO_YOUTUBE_PO_TOKEN=
RAYDIO_YOUTUBE_VISITOR_DATA=
